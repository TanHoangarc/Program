{
  "entities": {
    "Authorization": {
      "title": "Authorization",
      "description": "Văn bản ủy quyền (Power of Attorney) giữa các khách hàng",
      "type": "object",
      "properties": {
        "principalId": {
          "type": "string",
          "description": "Bên ủy quyền (Customer ID)"
        },
        "agentId": {
          "type": "string",
          "description": "Bên được ủy quyền (Customer ID)"
        },
        "expiryDate": {
          "type": "string",
          "description": "Thời hạn hiệu lực (YYYY-MM-DD)"
        },
        "attachmentUrl": {
          "type": "string",
          "description": "URL file đính kèm"
        },
        "attachmentName": {
          "type": "string",
          "description": "Tên file đính kèm"
        },
        "year": {
          "type": "integer",
          "description": "Năm hiệu lực để lọc"
        },
        "createdAt": {
          "type": "string",
          "description": "Thời gian tạo"
        }
      },
      "required": ["principalId", "agentId", "expiryDate", "year"]
    },
    "OnlinePresence": {
      "title": "OnlinePresence",
      "description": "Trạng thái trực tuyến của người dùng trên toàn hệ thống",
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "Tên tài khoản người dùng"
        },
        "role": {
          "type": "string",
          "description": "Vai trò của người dùng"
        },
        "avatar": {
          "type": "string",
          "description": "Ảnh đại diện người dùng"
        },
        "displayName": {
          "type": "string",
          "description": "Tên hiển thị"
        },
        "lastSeen": {
          "type": "number",
          "description": "Timestamp thời gian hoạt động gần nhất"
        },
        "loginTime": {
          "type": "string",
          "description": "Thời gian đăng nhập trong ngày"
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp cập nhật"
        }
      },
      "required": ["username", "role", "lastSeen"]
    }
  },
  "firestore": {
    "authorizations/{authorizationId}": {
      "schema": "Authorization",
      "description": "Danh sách các ủy quyền"
    },
    "online_presence/{userId}": {
      "schema": "OnlinePresence",
      "description": "Trạng thái online theo thời gian thực của người dùng"
    }
  }
}
